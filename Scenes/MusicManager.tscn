[sub_resource type="GDScript" id="GDScript_iysw5"]
script/source = "extends Node

@onready var player := AudioStreamPlayer.new()
@onready var beat_player = $AudioStreamPlayer2D

func _ready():
	add_child(player)
	add_child(beat_player)
	
	player.bus = \"Music\"
	beat_player.bus = \"Music\"

func play_level_music():
	player.stream = preload(\"res://Assets/Sound/levelMusic/crabRave.wav\")
	player.volume_db = -6.0
	player.play()

func stop():
	player.stop()
"

